  <body>
    <h1>Weather Forecast</h1>

<form action="/" accept-charset="UTF-8" method="get">
  <div class="field">
    <label for="line_1">Address Line 1</label>
    <input type="text" name="line_1" id="line_1" />
  </div>

  <div class="field">
    <label for="line_2">Address Line 2</label>
    <input type="text" name="line_2" id="line_2" />
  </div>

  <div class="field">
    <label for="city">City</label>
    <input type="text" name="city" id="city" />
  </div>

  <div class="field">
    <label for="state">State</label>
    <input type="text" name="state" id="state" />
  </div>

  <div class="field">
    <label for="zip">Zip Code</label>
    <input type="text" name="zip" id="zip" />
  </div>

  <div class="field">
    <label for="country">Country</label>
    <input type="text" name="country" id="country" />
  </div>

  <div class="field">
    <label for="unit">Temperature Unit</label>
    <select name="unit" id="unit"><option selected="selected" value="imperial">Fahrenheit</option>
<option value="metric">Celsius</option></select>
  </div>

  <div class="actions">
    <input type="submit" name="commit" value="Get Forecast" data-disable-with="Get Forecast" />
  </div>
  
</form>
  <h2>Forecast for Natal</h2>
  <p>Light rain</p>
  <p>AverageTemperature: 75°F</p>
  <p>Feels Like: 77°F</p>
  <p>Min Temperature: 75°F</p>
  <p>Max Temperature: 76°F</p>
  <p>Humidity: 94%</p>
  <p>Wind Speed: 9.22 mph</p>
  <p>Wind Direction: <span style="display: inline-block; transform: rotate(180deg);">↑</span> (180°)</p>
  <p>Cached? No</p>


